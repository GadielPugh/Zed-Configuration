{
    // =========================
    // Editor Appearance
    // =========================
    "cli_default_open_behavior": "existing_window",
    "collaboration_panel": {
        "dock": "left",
    },
    "git_panel": {
        "dock": "left",
    },
    "vim": {
        "gdefault": false,
    },
    "minimap": {
        "max_width_columns": 60,
        "show": "always",
    },
    "buffer_line_height": "comfortable",
    "buffer_font_weight": 400.0,
    "text_rendering_mode": "platform_default",
    "agent_buffer_font_size": 12.0,
    "active_pane_modifiers": {
        "inactive_opacity": 1.0,
        "border_size": 0.0,
    },
    "preview_tabs": {
        "enabled": true,
    },
    "tabs": {
        "file_icons": false,
    },
    "agent_servers": {
        "codex-acp": {
            "type": "registry",
        },
    },
    "agent_ui_font_size": 16.0,

    "buffer_font_family": "FiraCode Nerd Font",

    "tab_size": 4,
    "toolbar": {
        "quick_actions": false,
    },
    "colorize_brackets": true,
    "show_signature_help_after_edits": true,
    "icon_theme": "Material Icon Theme",
    "project_panel": {
        "entry_spacing": "comfortable",
        "dock": "left",
        "bold_folder_labels": false,
        "auto_fold_dirs": true,
        "starts_open": true,
        "auto_reveal_entries": true,
        "indent_size": 20.0,
        "git_status": true,
        "folder_icons": true,
        "file_icons": true,
        "hide_root": true,
        "default_width": 400.0,
        "indent_guides": {
            "show": "never",
        },
    },
    "disable_ai": false,
    "inlay_hints": {
        "enabled": true,
        "show_other_hints": true,
        "show_parameter_hints": false,
        "show_type_hints": false,
        "show_value_hints": true,
    },
    "ui_font_size": 17.0,
    "buffer_font_size": 13.0,

    "buffer_font_features": {
        "calt": true,
        "liga": true,
    },

    "lsp_document_colors": "border",
    "wrap_guides": [79],
    "show_edit_predictions": false,

    // =========================
    // Theme & Colors
    // =========================
    "theme": {
        "mode": "system",
        "light": "Aura Soft Dark",
        "dark": "Aura Dark",
    },
    "theme_overrides": {
        "Aura Dark": {
            "editor.document_highlight.read_background": "#00000000",
            "editor.document_highlight.write_background": "#00000000",
            "border.variant": "#15141C",
            "border": "#15141C",
            "title_bar.background": "#15141C",
            "panel.focused_border": "#4E466E",
            "players": [
                {
                    "cursor": "#BD9DFF",
                },
            ],
            "syntax": {
                "comment": {
                    "font_style": "italic",
                },
                "comment.doc": {
                    "font_style": "italic",
                },

                // VARIABLES (teal)
                "variable": {
                    "color": "#FFFFFF",
                },
                "property": {
                    "color": "#2EC4B6",
                },

                // FUNCTIONS (teal + italic)
                "function": {
                    // "color": "#2EC4B6",
                    "font_style": "italic",
                },

                // PARAMETERS (white ✅)
                "parameter": {
                    // "color": "#FFFFFF",
                },
                "variable.parameter": {
                    // "color": "#FFFFFF",
                },

                // KEYWORDS
                "keyword": {
                    // "color": "#FFC067",
                    "font_style": "italic",
                },
                "keyword.function": {
                    "color": "#FFC067",
                    "font_style": "italic",
                },

                // BUILT-IN FUNCTIONS
                "support.function": {
                    // "color": "#2EC4B6",
                    "font_style": "italic",
                },

                // VALUES
                "string": {
                    "color": "#d8bf",
                },
                "number": {
                    // "color": "#FFC8A2",
                },
                "constant": {
                    "color": "#FFC8A2",
                },

                // PUNCTUATION
                "punctuation.delimiter": {
                    "color": "#2EC4B6",
                },
                "punctuation": {
                    "color": "#2EC4B6",
                },
            },
        },
    },

    "title_bar": {
        "show_project_items": false,
        "show_branch_name": false,
    },
    "tab_bar": {
        "show": false,
    },
    "file_finder": {
        "modal_max_width": "xlarge",
    },
    "outline_panel": {
        "dock": "left",
        "default_width": 300,
    },
    "gutter": {
        "min_line_number_digits": 0,
    },

    // =========================
    // Editor Behavior
    // =========================
    "autosave": {
        "after_delay": { "milliseconds": 500 },
    },
    "format_on_save": "on",
    "restore_on_startup": "last_session",
    "show_completions_on_input": true,

    // =========================
    // AI & Assistant Features
    // =========================
    "agent": {
        "dock": "right",
        "button": true,
        "flexible": true,
        "play_sound_when_agent_done": "always",
        "inline_assistant_model": {
            "provider": "zed.dev",
            "model": "claude-sonnet-4-thinking",
        },
        "default_model": {
            "enable_thinking": true,
            "provider": "google",
            "model": "gemini-2.5-flash",
        },
    },
    "edit_predictions": {
        "provider": "zed",
        "mode": "eager",
        "enabled_in_text_threads": false,
        "copilot": {
            "proxy": null,
            "proxy_no_verify": null,
        },
    },

    // =========================
    // Git Integration
    // =========================
    "git": {
        "inline_blame": { "enabled": false },
    },

    // =========================
    // Language-Specific Settings
    // =========================
    "languages": {
        "Python": {
            "show_edit_predictions": false,
            "formatter": {
                "external": {
                    "command": "black",
                    "arguments": ["-", "--skip-string-normalization"],
                },
            },
            "format_on_save": "on",
        },
        "Rust": {
            "formatter": {
                "external": {
                    "command": "rustfmt",
                    "arguments": [],
                },
            },
            "format_on_save": "on",
        },
    },

    // =========================
    // LSP
    // =========================
    "lsp": {
        "rust-analyzer": {
            "initialization_options": {
                "check": {
                    "command": "clippy",
                },
                "imports": {
                    "merge": { "glob": false },
                    "granularity": {
                        "enforce": true,
                        "group": "module",
                    },
                },
                "inlayHints": {
                    "maxLength": null,
                    "lifetimeElisionHints": {
                        "enable": "skip_trivial",
                        "useParameterNames": true,
                    },
                    "closureReturnTypeHints": {
                        "enable": "always",
                    },
                },
            },
        },
    },

    // =========================
    // Privacy
    // =========================
    "telemetry": {
        "diagnostics": false,
        "metrics": false,
    },
}
